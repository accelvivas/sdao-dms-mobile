{
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "NOTIFICATIONS_ENABLED": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "release-apk": {
      "distribution": "internal",
      "channel": "release",
      "env": {
        "NOTIFICATIONS_ENABLED": "true",
        "PUSH_NOTIFICATIONS_ENABLED": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "NOTIFICATIONS_ENABLED": "true",
        "PUSH_NOTIFICATIONS_ENABLED": "false"
      }
    }
  }
}
